# Optional: residential/rotating proxy for outbound requests.
# Picked up automatically by the underlying httpx client (no code changes needed).

HTTPS_PROXY=

# Optional: plain HTTP proxy, same auto-pickup as HTTPS_PROXY above.

HTTP_PROXY=

# Reserved for future use: identity/session token from a Google account
# logged into YouTube. Not consumed by the library yet - safe to leave blank.
# Geeky User? fork & try to implement successfully 

YTS_IDENTITY_TOKEN=

# Optional: path to a Netscape-format cookies.txt for authenticated requests
# (age-restricted/members-only videos, avoiding bot-detection challenges).
# Needed Only for StreamURLFetcher and Transcript to work reliably; both fall
# back to unauthenticated requests if this file isn't found.

YOUTUBE_COOKIES_FILE=cookies.txt

# Optional alternative to YOUTUBE_COOKIES_FILE: a URL to fetch the cookie
# file from instead of reading a local path (e.g. a pastebin/batbin raw
# link). Only used if YOUTUBE_COOKIES_FILE isn't found on disk. Downloaded
# once per process and cached in a temp file, not fetched on every request.

COOKIE_URL=
